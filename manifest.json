{
  "manifest_version": 3,
  "name": "Skyroom Link Mute",
  "version": "1.2.0",
  "description": "ساکت کردن خودکار کاربران ارسال‌کننده لینک و آیدی کانال در چت اسکای‌روم",
  "permissions": ["storage"],
  "host_permissions": ["https://www.skyroom.online/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Skyroom Link Mute",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.skyroom.online/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}